{
  "name": "pharmacovigilance-normandie",
  "private": true,
  "description": "HTML and accessibility checks for the rendered site (_site/).",
  "scripts": {
    "check:html": "html-validate \"_site/**/*.html\"",
    "check:a11y": "node tools/a11y/run-axe.mjs",
    "check:mobile": "node tools/checks/check_mobile.mjs",
    "test:js": "node --test \"tests/js/*.test.mjs\""
  },
  "devDependencies": {
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "html-validate": "^9.0.0"
  }
}
